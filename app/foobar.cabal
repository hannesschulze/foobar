cabal-version: 3.0
name:          foobar
version:       2.0.0
synopsis:      A simple bar, launcher, control center, and notification daemon.
build-type:    Simple

common warnings
    ghc-options: -Wall

executable foobar
    import:           warnings
    main-is:          Main.hs
    build-depends:    base,
                      haskell-gi,
                      haskell-gi-base,
                      gi-gio,
                      gi-gtk4,
                      gi-foobar
    default-language: Haskell2010
